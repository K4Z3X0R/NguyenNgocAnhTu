<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerAddresses</key>
                <array>
                    <string>94.140.14.14</string>
                    <string>94.140.15.15</string>
                    <string>2a10:50c0::ad1:ff</string>
                    <string>2a10:50c0::ad2:ff</string>
                </array>
                <key>ServerURL</key>
                <string>https://dns.adguard-dns.com/dns-query</string>
            </dict>
            <key>OnDemandRules</key>
            <array>
                <!-- ========================================================================= -->
                <!-- 1. BẢO VỆ TUYỆT ĐỐI LUỒNG ĐĂNG NHẬP SPOTIFY, GOOGLE YOUTUBE & LOCKET AUTH -->
                <!-- Cho phép các domain xác thực tài khoản chạy trực tiếp, chống 100% lỗi login -->
                <!-- ========================================================================= -->
                <dict>
                    <key>Action</key>
                    <string>EvaluateConnection</string>
                    <key>ActionParameters</key>
                    <array>
                        <dict>
                            <key>DomainAction</key>
                            <string>NeverConnect</string>
                            <key>Domains</key>
                            <array>
                                <!-- === SPOTIFY LOGIN & AUTH DEALER === -->
                                <string>login5.spotify.com</string>
                                <string>accounts.spotify.com</string>
                                <string>dealer.spotify.com</string>
                                <string>gew-dealer.spotify.com</string>
                                <string>ap-gew4.spotify.com</string>
                                
                                <!-- === GOOGLE / YOUTUBE ACCOUNT AUTH === -->
                                <string>accounts.google.com</string>
                                <string>oauth2.googleapis.com</string>
                                
                                <!-- === LOCKET / FIREBASE AUTHENTICATION === -->
                                <string>identitytoolkit.googleapis.com</string>
                                <string>securetoken.googleapis.com</string>
                                <string>api.locketcamera.com</string>
                            </array>
                        </dict>
                    </array>
                </dict>
                <!-- ========================================================================= -->
                <!-- 2. TOÀN BỘ TRUY VẤN CÒN LẠI ĐI QUA ADGUARD ANYCAST DOH LỌC SẠCH QUẢNG CÁO -->
                <!-- Chặn Audio/Podcast Ads Spotify, Video Ads YouTube Web & Telemetry         -->
                <!-- ========================================================================= -->
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
            </array>
            <key>PayloadDescription</key>
            <string>Bản Siêu Cấp v4.0: Chặn 100% Audio Ads Spotify, Video Ads YouTube • Miễn nhiễm hoàn toàn lỗi đăng nhập (Zero Login Failure) • Mã hóa DoH Anycast AdGuard • Không hao pin • Bảo toàn 100% Push Notifications</string>
            <key>PayloadDisplayName</key>
            <string>👑 Anh Tú • Spotify &amp; YouTube Apex DNS 🎵▶️</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.spotify.youtube.apex.v4</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>E716BE72-4C6C-49F1-8B35-2470A7DB9845</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>ProhibitDisablement</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>✨ Cấu hình DNS Tối Thượng: Triệt hạ Audio Ads Spotify, Video Ads YouTube, Bảo lưu Locket Gold &amp; Miễn nhiễm 100% lỗi xác thực đăng nhập • Tác giả: Nguyễn Ngọc Anh Tú (@z3rokaze)</string>
    <key>PayloadDisplayName</key>
    <string>👑 Anh Tú • Spotify &amp; YouTube Apex DNS 🎵▶️</string>
    <key>PayloadIdentifier</key>
    <string>com.z3rokaze.profile.spotify.youtube.dns.v4</string>
    <key>PayloadOrganization</key>
    <string>Nguyễn Ngọc Anh Tú (z3rokaze)</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>8A16F082-D08F-42E1-9D27-E4912BFD642C</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
